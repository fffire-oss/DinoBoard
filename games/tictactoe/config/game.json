{
  "game_id": "tictactoe",
  "display_name": "井字棋",
  "display_name_en": "Tic-Tac-Toe",
  "players": {
    "min": 2,
    "max": 2
  },
  "action_space": 9,
  "feature_dim": 28,
  "max_game_plies": 9,
  "mcts_profiles": {
    "selfplay": {
      "simulations": 100,
      "c_puct": 1.4,
      "temperature": 1.0,
      "temperature_schedule": {"enabled": true, "initial": 1.0, "final": 0.1, "decay_plies": 6},
      "dirichlet_alpha": 1.0,
      "dirichlet_epsilon": 0.25,
      "dirichlet_on_first_n_plies": 9,
      "opponent_selection": "puct",
      "tail_solve_enabled": false,
      "tail_solve_depth_limit": 5,
      "tail_solve_node_budget": 10000000,
      "tail_solve_margin_weight": 0.0,
      "ai_use_action_filter": false,
      "cover_root_edges": false
    },
    "arena": {
      "inherits": "selfplay",
      "temperature": 0.0,
      "temperature_schedule": {"enabled": false, "initial": 0.0, "final": 0.0, "decay_plies": 0},
      "dirichlet_epsilon": 0.0,
      "dirichlet_on_first_n_plies": 0
    },
    "eval": {
      "inherits": "arena"
    }
  },
  "training": {
    "episodes_per_step": 200,
    "batch_size": 256,
    "learning_rate": 0.001,
    "steps": 500
  },
  "network": {
    "type": "mlp",
    "hidden_layers": [
      64,
      64
    ],
    "activation": "relu"
  }
}
