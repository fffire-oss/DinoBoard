{
  "game_id": "loveletter",
  "display_name": "\u60c5\u4e66",
  "display_name_en": "Love Letter",
  "has_web": true,
  "players": {
    "min": 2,
    "max": 4
  },
  "action_space": 47,
  "feature_dim": 70,
  "training": {
    "simulations": 200,
    "c_puct": 1.4,
    "temperature": 1.0,
    "temperature_schedule": {
      "enabled": true,
      "initial": 1.0,
      "final": 0.1,
      "decay_plies": 10
    },
    "dirichlet_alpha": 0.5,
    "dirichlet_epsilon": 0.10,
    "dirichlet_on_first_n_plies": 5,
    "max_game_plies": 30,
    "episodes_per_step": 100,
    "batch_size": 512,
    "learning_rate": 0.0005,
    "steps": 4000,
    "heuristic_guidance_hold_steps": 10,
    "heuristic_guidance_steps": 200,
    "heuristic_guidance_initial_ratio": 1.0,
    "heuristic_guidance_temperature": 1.5,
    "heuristic_temperature": 0.0,
    "eval_benchmarks": ["heuristic_constrained", "heuristic_free"]
  },
  "network": {
    "type": "mlp",
    "hidden_layers": [
      256,
      256,
      128
    ],
    "activation": "relu"
  }
}
